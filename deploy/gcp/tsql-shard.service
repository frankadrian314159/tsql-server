[Unit]
Description=tsql-server shard node
After=network-online.target
Wants=network-online.target

[Service]
User=tsql
# a durable shard: write-ahead log and checkpoints in /var/lib/tsql/shard; metrics for the Ops Agent / Prometheus
# /etc/tsql/certs holds the cluster's ca.pem and this node's node.pem and node.key (tsql-cluster --make-certs; not ca.key)
ExecStart=/usr/local/bin/tsql-shard --id ${SHARD_ID} --listen 0.0.0.0:50051 --data /var/lib/tsql/shard --drain-secs 20 --metrics-listen 0.0.0.0:9101 --node-ca /etc/tsql/certs/ca.pem --node-cert /etc/tsql/certs/node.pem --node-key /etc/tsql/certs/node.key
EnvironmentFile=/etc/tsql/shard.env
# SIGTERM (what systemctl stop and a GCE shutdown send) drains the node: no new work, open transactions finish, the log is
# forced and a checkpoint written. Give it longer than --drain-secs plus the checkpoint.
KillSignal=SIGTERM
TimeoutStopSec=60
Restart=on-failure
RestartSec=2
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
